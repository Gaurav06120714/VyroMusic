# =============================================================================
# VyroMusic API — Environment Variables
# Copy: cp apps/api/.env.example apps/api/.env
# Never commit a .env file with real values.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3006
# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:3005
# Reverse-proxy hops: 1 for Nginx/ALB, 0 for direct dev
PROXY_DEPTH=1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vyro:vyro@localhost:5432/vyro_music

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_CRYPTO_RANDOM
# Must be DIFFERENT from JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARS

# ── Security / Rate limiting ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
IP_HASH_SALT=REPLACE_WITH_RANDOM_HEX_FOR_PRIVACY_PRESERVING_LOGS

# ── Stripe ────────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Products → create one per plan → copy price ID
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_FAMILY_PRICE_ID=price_...
STRIPE_STUDENT_PRICE_ID=price_...
